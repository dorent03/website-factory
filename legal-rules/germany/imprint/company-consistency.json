{
  "id": "de.imprint.company-consistency",
  "title": "Unternehmensangaben konsistent",
  "description": "Firma, Rechtsform, Anschrift, Vertreter und Registerdaten müssen in Impressum, Datenschutzerklärung (Verantwortlicher), Footer, Formularen, E-Mail-Vorlagen und strukturierten Daten übereinstimmen. Abweichungen deuten auf veraltete oder erfundene Daten hin.",
  "jurisdiction": "DE",
  "category": "imprint",
  "sources": [
    {
      "title": "§ 5 DDG – Allgemeine Informationspflichten",
      "url": "https://www.gesetze-im-internet.de/ddg/__5.html",
      "publisher": "Bundesministerium der Justiz und für Verbraucherschutz / juris (gesetze-im-internet.de)",
      "retrieved": "2026-11-02"
    },
    {
      "title": "Verordnung (EU) 2016/679 (DSGVO), insbesondere Art. 5, 6, 7, 12, 13, 25, 28, 32, 44–49",
      "url": "https://eur-lex.europa.eu/eli/reg/2016/679/oj/deu",
      "publisher": "Amt für Veröffentlichungen der EU (EUR-Lex)",
      "retrieved": "2026-11-02"
    }
  ],
  "lastReviewed": "2026-11-02",
  "ruleVersion": "1.0.0",
  "severity": "major",
