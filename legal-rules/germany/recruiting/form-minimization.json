{
  "id": "de.recruiting.form-minimization",
  "title": "Bewerbungsformular: Datenminimierung",
  "description": "Nur für die Stellenbesetzung erforderliche Pflichtfelder; kein Pflichtfeld für Foto, Geburtsdatum, Familienstand, Staatsangehörigkeit, Religion oder Gesundheit (Art. 5 Abs. 1 lit. c, Art. 9 DSGVO; zugleich AGG-Risiko nach §§ 11, 15 AGG).",
  "jurisdiction": "DE",
  "category": "recruiting",
  "sources": [
    {
      "title": "Verordnung (EU) 2016/679 (DSGVO), insbesondere Art. 5, 6, 7, 12, 13, 25, 28, 32, 44–49",
      "url": "https://eur-lex.europa.eu/eli/reg/2016/679/oj/deu",
      "publisher": "Amt für Veröffentlichungen der EU (EUR-Lex)",
      "retrieved": "2026-11-02"
    },
    {
      "title": "§ 11 AGG – Ausschreibung",
      "url": "https://www.gesetze-im-internet.de/agg/__11.html",
      "publisher": "Bundesministerium der Justiz und für Verbraucherschutz / juris (gesetze-im-internet.de)",
      "retrieved": "2026-11-02"
    }
  ],
  "lastReviewed": "2026-11-02",
  "ruleVersion": "1.0.0",
  "severity": "major",
  "appliesWhen": {
    "siteTypes": [],
    "modules": [],
    "legalForms": [],
    "conditions": [
      "hasJobApplications"
    ]
  },
  "requiredFields": [],
  "automatedCheck": {
    "checkId": "forms.data-minimization",
    "params": {
      "form": "application",
      "forbiddenRequiredFields": [
        "photo",
        "dateOfBirth",
        "maritalStatus",
        "nationality",
        "religion",
        "health",
        "gender"
      ],
      "requirePrivacyNoticeLink": true
    }
  },
  "manualCheck": null
}
